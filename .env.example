PORT=3000
GOOGLE_SCRIPT_URL=
ADMIN_PIN=9876
ALLOWED_ORIGIN=

# ── Cloudflare Pages + Supabase ──
SUPABASE_URL=https://your-project.supabase.co

# service_role: bypasses Row Level Security. Server-side only, never shipped to a
# browser. Used for operator work and for writes customers must not control
# (price, status, dispatch).
SUPABASE_SERVICE_ROLE_KEY=

# anon/publishable key: safe to expose. Used together with a signed-in customer's
# JWT so Postgres RLS decides what they may read or write (profile, addresses,
# cart, their own orders). Without this, customer-scoped calls cannot be made and
# the RLS policies in supabase/migrations/ have nothing to act on.
SUPABASE_ANON_KEY=

# IST by default; controls the "today" window for operator reports.
KIOSK_UTC_OFFSET_MINUTES=330
